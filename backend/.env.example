# Copie para .env e preencha. Nunca commite o .env.
# Gere um token com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# Pasta onde os arquivos preparados ficam até o app baixar (no Docker já é /data/downloads).
DOWNLOAD_DIR=/data/downloads
# Tempo (s) que um job terminado fica disponível antes da limpeza automática.
JOB_TTL_SECONDS=7200
# Quantos downloads o servidor prepara ao mesmo tempo.
MAX_CONCURRENT_JOBS=2
